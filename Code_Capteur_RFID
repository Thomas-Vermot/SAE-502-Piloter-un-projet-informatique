void setup_wifi() {
  delay(10);
  Serial.print("\nConnexion a ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connecte !");
  Serial.println("adresse ip: ");
  Serial.println(WiFi.localIP());
}

void reconnect() {
  while (!client.connected()) {
    const char* willTopic = "RFID/status";
    const char* willMessage = "offline";
    bool willRetain = true;
    int willQos = 1;

    if (client.connect("esp8266", mqtt_user, mqtt_mdp, willTopic, willQos, willRetain, willMessage)) {
      Serial.println("Connecté au Broker !");      
      client.publish(willTopic, "online", true); 
    } 
    else {
      Serial.print("Echec, code d'erreur = ");
      Serial.print(client.state());
      Serial.println(" Réessai dans 5 secondes");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  setup_wifi();
  client.setServer(mqtt_server, 1883);
  dht22.begin();
  Wire.begin(4, 5);
  pinMode(PIN_TO_SENSOR, INPUT);
  pinMode(TILT_PIN, INPUT_PULLUP);
  pinMode(PIR_PIN, INPUT); 
  nfc.begin();
  uint32_t versiondata = nfc.getFirmwareVersion();
  if (!versiondata) {
    Serial.println("PN532 non trouvé !");
  } else {
    Serial.println("NFC Elechouse Prêt !");
    nfc.SAMConfig(); 
  }

  Serial.println("Systeme pret !");
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

/*-------------------------------------------*/

//capteur RFID
  uint8_t success;
  uint8_t uid[] = { 0, 0, 0, 0, 0, 0, 0 };
  uint8_t uidLength;

  success = nfc.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid, &uidLength, 50);

  if (success) {
    Serial.print("NFC trouvé ! UID: ");
    
    // 1. Conversion de l'UID en String hexadécimale
    String uidString = "";
    for (uint8_t i=0; i < uidLength; i++) {
      if (uid[i] < 0x10) uidString += "0";
      uidString += String(uid[i], HEX);
      Serial.print(uid[i], HEX);
      Serial.print(" ");
    }
    Serial.println("");    
    uidString.toUpperCase();
    client.publish("RFID", uidString.c_str(), true);
  }
  delay(2000);
}
